# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# APP_ALLOWED_ORIGINS: Comma-separated list of allowed origins for CORS.
# Example: https://app.example.com,https://admin.example.com
APP_ALLOWED_ORIGINS=

# ENFORCE_HTTPS: When true in production, redirects HTTP requests to HTTPS.
ENFORCE_HTTPS="true"

# TRUST_PROXY: If running behind a reverse proxy or load balancer, set to true.
TRUST_PROXY="true"

# ALLOW_IFRAME: Set to true only when embedding in a trusted iframe like AI Studio.
ALLOW_IFRAME="false"

# API_SECRET_KEY: Shared secret key for API route authentication (Server-side)
API_SECRET_KEY=""

# VITE_API_SECRET_KEY: Shared secret key for API route authentication (Client-side)
VITE_API_SECRET_KEY=""

# CLOUD SQL DATABASE CONFIGURATION
SQL_HOST="localhost"
SQL_USER="postgres_user"
SQL_PASSWORD="postgres_password"
SQL_DB_NAME="postgres_db"
SQL_ADMIN_USER="postgres_admin"
SQL_ADMIN_PASSWORD="postgres_admin_password"
SQL_SSL=""

# STRIPE BILLING INTEGRATION
STRIPE_SECRET_KEY=""
VITE_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Firebase Client Configuration (for the browser app)
# These values must match the Firebase project that backs your deployed app.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""

# Firebase Admin Service Account
# Use either the JSON contents here or the path to a service account file.
# For production, prefer configuring GOOGLE_APPLICATION_CREDENTIALS in the host environment.
FIREBASE_SERVICE_ACCOUNT_KEY=""
GOOGLE_APPLICATION_CREDENTIALS=""

# ERROR TRACKING (Sentry)
# Optional but strongly recommended in production. Without it, errors are only
# visible in server logs. Server-side DSN only — this is never exposed to the client.
SENTRY_DSN=""

